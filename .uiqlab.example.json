{
  "projectKey": "123e4567-e89b-12d3-a456-426614174000",
  "name": "example-web-app",
  "ci": {
    "branches": [
      "main",
      "feature/ui-*",
      "redesign/**"
    ],
    "baselineBranch": "main",
    "pages": [
      {
        "path": "/",
        "profile": "general-review",
        "direction": "observe",
        "qualityGate": {
          "mode": "report"
        }
      },
      {
        "path": "/checkout",
        "profile": "accessibility",
        "direction": "reduce-issues",
        "qualityGate": {
          "mode": "enforce"
        }
      },
      {
        "path": "/catalog",
        "profile": "visual-complexity",
        "direction": "decrease",
        "qualityGate": {
          "mode": "warn"
        }
      }
    ]
  }
}
