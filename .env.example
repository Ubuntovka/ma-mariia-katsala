# PostgreSQL Configuration
POSTGRES_USER=orchestrator
POSTGRES_PASSWORD=orchestrator
POSTGRES_DB=orchestrator_db

# Orchestrator Configuration
# Complete URL of the separate metric backend on thesis-network. A trailing
# slash is optional and is normalized by the orchestrator.
BACKEND_URL=http://nginx
# Base URL serving evaluator-generated /input_files and /results artifacts.
# This default reaches evaluator1's published port from Docker Desktop.
BACKEND_ARTIFACT_URL=http://host.docker.internal:8001
ORCHESTRATOR_PORT=8181
UIQLAB_RESULT_READ_TIMEOUT_SECONDS=300

# Optional OpenAI-compatible Chat Completions provider (server-side only)
# OpenAI example: https://api.openai.com/v1/chat/completions
LLM_API_URL=https://your-university-llm.example/v1/chat/completions
LLM_API_KEY=replace-with-your-api-key
LLM_MODEL=replace-with-your-model-name
LLM_CONNECT_TIMEOUT_SECONDS=60
LLM_TIMEOUT_SECONDS=180
