{
  "name": "uiqlab-assessment",
  "displayName": "UIQLab Assessment",
  "description": "Continuous Web UI quality assessment in VS Code",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:uiqlab-assessment.runAssessment",
    "onCommand:uiqlab-assessment.comparePastAssessments",
    "onView:uiqlab-assessment.sidebar"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "uiqlab-assessment",
          "title": "UIQLab Assessment",
          "icon": "media/uiqlab.svg"
        }
      ]
    },
    "views": {
      "uiqlab-assessment": [
        {
          "id": "uiqlab-assessment.sidebar",
          "name": "Configure Assessment",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "uiqlab-assessment.runAssessment",
        "title": "Run Assessment"
      },
      {
        "command": "uiqlab-assessment.comparePastAssessments",
        "title": "Compare Past Assessments"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "node scripts/clean-test-output.mjs && tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "mocha --ui tdd \"out/test/**/*.test.js\"",
    "pretest:integration": "npm run compile-tests && npm run compile && npm run lint",
    "test:integration": "vscode-test"
  },
  "dependencies": {
    "form-data": "^4.0.0",
    "playwright-core": "^1.44.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/pngjs": "^6.0.5",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "mocha": "^11.7.6",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
